[gd_scene format=3]

[ext_resource type="Script" path="res://src/ui/menu/main_menu.gd" id="1_script"]
[ext_resource type="Script" path="res://src/ui/common/menu_backdrop.gd" id="2_backdrop"]
[ext_resource type="Script" path="res://src/ui/common/slime_icon.gd" id="3_logo"]
[ext_resource type="PackedScene" path="res://src/ui/menu/level_card.tscn" id="4_card"]
[ext_resource type="PackedScene" path="res://src/ui/settings/settings_dialog.tscn" id="5_dialog"]

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Backdrop" type="Control" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("2_backdrop")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 80
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 80
theme_override_constants/margin_bottom = 12

[node name="Scroll" type="ScrollContainer" parent="Margin"]
layout_mode = 2
horizontal_scroll_mode = 0

[node name="VBox" type="VBoxContainer" parent="Margin/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="Header" type="HBoxContainer" parent="Margin/Scroll/VBox"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="Logo" type="Control" parent="Margin/Scroll/VBox/Header"]
unique_name_in_owner = true
custom_minimum_size = Vector2(88, 88)
layout_mode = 2
script = ExtResource("3_logo")

[node name="Titles" type="VBoxContainer" parent="Margin/Scroll/VBox/Header"]
layout_mode = 2
theme_override_constants/separation = -4
alignment = 1

[node name="Title" type="Label" parent="Margin/Scroll/VBox/Header/Titles"]
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "史萊姆方塊吞噬者"

[node name="Subtitle" type="Label" parent="Margin/Scroll/VBox/Header/Titles"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"CaptionLabel"
text = "SLIME BLOCK EATER  //  BUILD & PLAY"

[node name="Spacer" type="Control" parent="Margin/Scroll/VBox/Header"]
layout_mode = 2
size_flags_horizontal = 3

[node name="VolumeBox" type="PanelContainer" parent="Margin/Scroll/VBox/Header"]
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"InsetPanel"

[node name="HBox" type="HBoxContainer" parent="Margin/Scroll/VBox/Header/VolumeBox"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="MuteButton" type="Button" parent="Margin/Scroll/VBox/Header/VolumeBox/HBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(104, 0)
layout_mode = 2
theme_type_variation = &"ChipButton"
toggle_mode = true
text = "音量"

[node name="VolumeSlider" type="HSlider" parent="Margin/Scroll/VBox/Header/VolumeBox/HBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(200, 0)
layout_mode = 2
size_flags_vertical = 4
max_value = 100.0
step = 1.0
value = 80.0

[node name="VolumeValue" type="Label" parent="Margin/Scroll/VBox/Header/VolumeBox/HBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(72, 0)
layout_mode = 2
theme_type_variation = &"CaptionLabel"
text = "80%"
horizontal_alignment = 2

[node name="SettingsButton" type="Button" parent="Margin/Scroll/VBox/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
text = "設定"

[node name="QuitButton" type="Button" parent="Margin/Scroll/VBox/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
text = "離開"

[node name="HeaderLine" type="HSeparator" parent="Margin/Scroll/VBox"]
layout_mode = 2

[node name="ModeTabs" type="HBoxContainer" parent="Margin/Scroll/VBox"]
layout_mode = 2
theme_override_constants/separation = 12
alignment = 1

[node name="OfficialTab" type="Button" parent="Margin/Scroll/VBox/ModeTabs"]
unique_name_in_owner = true
custom_minimum_size = Vector2(260, 46)
layout_mode = 2
theme_type_variation = &"ChipButton"
toggle_mode = true
text = "關卡 PLAY"

[node name="CustomTab" type="Button" parent="Margin/Scroll/VBox/ModeTabs"]
unique_name_in_owner = true
custom_minimum_size = Vector2(260, 46)
layout_mode = 2
theme_type_variation = &"ChipButton"
toggle_mode = true
text = "編輯 BUILD"

[node name="WorldTabs" type="HBoxContainer" parent="Margin/Scroll/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 12

[node name="SectionHeader" type="HBoxContainer" parent="Margin/Scroll/VBox"]
layout_mode = 2

[node name="SectionTitle" type="Label" parent="Margin/Scroll/VBox/SectionHeader"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"HeadingLabel"
theme_override_font_sizes/font_size = 26
text = "冒險挑戰關卡 LEVEL SELECT"

[node name="ProgressLabel" type="Label" parent="Margin/Scroll/VBox/SectionHeader"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"BadgeLabel"
text = "已通關 0 / 50"

[node name="Grid" type="GridContainer" parent="Margin/Scroll/VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/h_separation = 16
theme_override_constants/v_separation = 14
columns = 3

[node name="BossCard" parent="Margin/Scroll/VBox" instance=ExtResource("4_card")]
unique_name_in_owner = true
layout_mode = 2

[node name="VersionLabel" type="Label" parent="Margin/Scroll/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"CaptionLabel"
theme_override_font_sizes/font_size = 15
text = "DEVOURER SLIME"
horizontal_alignment = 1

[node name="SettingsDialog" parent="." instance=ExtResource("5_dialog")]
unique_name_in_owner = true
visible = false
layout_mode = 1
