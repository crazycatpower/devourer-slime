; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Devourer Slime"
config/name_localized={
"zh_TW": "史萊姆方塊吞噬者"
}
config/description="Eat blocks, spit them back out, and bounce through 5 worlds."
config/version="0.2.0"
run/main_scene="res://src/app/app.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Settings="*res://src/autoload/settings.gd"
LevelStore="*res://src/autoload/level_store.gd"
Progress="*res://src/autoload/progress.gd"
AudioDirector="*res://src/autoload/audio_director.gd"

[debug]

gdscript/warnings/unused_variable=2
gdscript/warnings/unused_parameter=2
gdscript/warnings/shadowed_variable=2
gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_call_argument=2
gdscript/warnings/integer_division=2
gdscript/warnings/narrowing_conversion=2

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://src/ui/theme/game_theme.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.027, 0.043, 0.102, 1)
